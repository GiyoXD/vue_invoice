# Exclude from Docker build context
.git
.pyre
.pyre_configuration
.agent
.env

# Python artifacts
__pycache__
*.pyc
*.pyo

# Data directories (mounted as volumes instead)
storage/generated/
storage/uploads/
storage/db/*.db*
storage/db/*.db-journal
storage/blueprints/*
!storage/blueprints/mapper/
!storage/blueprints/bundled/
output/
run_log/
tmp/

# Dev/test files
tests/
*.ps1
note.md
