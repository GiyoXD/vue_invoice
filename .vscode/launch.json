{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Debug Runner",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scratch/debug_runner.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Python: Blueprint Debug Runner",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scratch/debug_blueprint_runner.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Python: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ]
}
